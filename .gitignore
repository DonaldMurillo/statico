# pi: track skills (project content) + plugins, ignore the transient
# runtime state (manager config, missions, tasks, subagent failures).
.pi/agent-manager/
.pi/missions/
.pi/tasks/
.pi/subagent-failures/
pi-agent/plugins/*
!pi-agent/plugins/registry.json

# Added by cargo
/target

# Internal-only docs (planning, design drafts, security audit working notes,
# generated debug reports). Kept locally for the maintainer; not part of the
# public repo.
/docs/internal/

# Python bytecode caches from the benchmark scripts
__pycache__/
*.pyc

# Test output
test-output/

# Public benchmark repos (large, auto-managed)
benchmarks/repos/
benchmarks/rust-repos/
benchmarks/rust-results/
benchmarks/results/

tmp-plugin-test/

# .claude/ is tracked (project skills, CLAUDE.md). Only ignore transient
# runtime state inside it.
.claude/scheduled_tasks.lock
.claude/**/*.tmp

# statico — only the transient subdirs. `.statico/plugins/` is project
# content (user-authored plugins) and must stay trackable. `.statico.toml`
# at the repo root is config and unaffected.
.statico/cache/
.statico/runtimes/

# fallow's cache files dropped into project roots when its CLI is run
# against fixtures. We do not want them tracked.
.fallow/

# Website (Angular)
website/dist/
website/node_modules/
website/screenshots/
website/test-results/
website/playwright-report/
website/.angular/

# Plugin example node_modules / bun lockfiles. The lockfiles in particular
# pin our local-path SDK link by absolute path, so committing them would
# break for other contributors.
examples/plugins/*/node_modules/
examples/plugins/*/bun.lock
examples/plugins/*/bun.lockb

# Plugin SDK build artifacts. dist/ is regenerated by `bun run build` (and
# CI verifies it builds); node_modules/ + lockfile follow the same logic
# as the example plugins above.
sdks/typescript/dist/
sdks/typescript/node_modules/
sdks/typescript/bun.lock
sdks/typescript/bun.lockb
sdks/rust/target/
