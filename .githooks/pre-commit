#!/usr/bin/env bash
# pre-commit: format check (Rust) + typo check + TS SDK typecheck on staged files.
# Install: scripts/setup-hooks.sh (sets core.hooksPath = .githooks)
set -euo pipefail

# 1) cargo fmt — only when Rust files are staged.
rust_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
if [ -n "$rust_files" ]; then
    if ! cargo fmt --all -- --check; then
        echo ""
        echo "Rust formatting check failed. Run 'cargo fmt' and re-stage."
        exit 1
    fi
fi

# 2) typos — fast spell-check on staged files. Skipped if `typos` not installed.
if command -v typos >/dev/null 2>&1; then
    staged=$(git diff --cached --name-only --diff-filter=ACM)
    if [ -n "$staged" ]; then
        # shellcheck disable=SC2086
        if ! typos $staged; then
            echo ""
            echo "Typos found. Run 'typos --write-changes' or fix manually, then re-stage."
            exit 1
        fi
    fi
else
    echo "(skipping typos check — install with 'cargo install typos-cli')"
fi

# 3) TS SDK typecheck — only when SDK source is staged. Skipped if bun is not
# installed (CI gates this anyway, so local skip is fine).
ts_sdk_files=$(git diff --cached --name-only --diff-filter=ACM -- 'sdks/typescript/**/*.ts' 'sdks/typescript/**/*.tsx' 'sdks/typescript/tsconfig*.json' 'sdks/typescript/package.json')
if [ -n "$ts_sdk_files" ]; then
    if command -v bun >/dev/null 2>&1; then
        if ! (cd sdks/typescript && bun run check) >/dev/null 2>&1; then
            echo ""
            echo "TypeScript SDK typecheck failed. Run 'cd sdks/typescript && bun run check' for details."
            exit 1
        fi
    else
        echo "(skipping TS SDK typecheck — bun not installed)"
    fi
fi
